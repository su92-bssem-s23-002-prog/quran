rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles - users can only read/write their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User bookmarks - users can only access their own bookmarks
    match /bookmarks/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User preferences - users can only access their own preferences
    match /preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public content that anyone can read (authenticated users only)
    match /duas/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can write (manage via console)
    }
    
    match /mosques/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
